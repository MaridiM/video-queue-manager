{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://rems.io/schemas/transcription/v2.0",
  "title": "Video Transcription Schema v2.0",
  "description": "Универсальная JSON-схема для хранения видео транскрипций с таксономическим анализом. Версия 2.0 - полное покрытие всех форматов из 02_TRANSCRIPTIONS",
  "version": "2.0.0",
  "type": "object",
  "required": ["video_id", "video_title", "metadata", "transcription"],
  "properties": {
    "video_id": {
      "type": "string",
      "description": "Уникальный идентификатор видео (Video_XXX)",
      "pattern": "^Video_[0-9]{3}$",
      "examples": ["Video_001", "Video_026"]
    },
    "video_title": {
      "type": "string",
      "description": "Название видео",
      "minLength": 1
    },
    "metadata": {
      "type": "object",
      "description": "Метаданные видео",
      "required": ["duration"],
      "properties": {
        "channel": { "type": "string", "description": "Название канала/создателя" },
        "creator": { "type": "string", "description": "Имя автора видео" },
        "channel_url": { "type": "string", "format": "uri", "description": "URL канала" },
        "video_url": { "type": "string", "format": "uri", "description": "URL видео" },
        "duration": { "type": "string", "description": "Продолжительность видео (MM:SS или HH:MM:SS)", "pattern": "^([0-9]{1,2}:)?[0-9]{2}:[0-9]{2}$" },
        "publication_date": { "type": "string", "format": "date", "description": "Дата публикации видео" },
        "extraction_date": { "type": "string", "format": "date", "description": "Дата извлечения/обработки транскрипции" },
        "extractor_version": { "type": "string", "description": "Версия экстрактора (v3.0, v3.1, v4.0)", "examples": ["v3.0", "v3.1", "v4.0"] },
        "language": { "type": "string", "description": "Язык видео", "default": "en" },
        "subtitles_exist": { "type": "boolean", "description": "Есть ли субтитры в видео", "default": false },
        "topics": { "type": "array", "description": "Список ключевых тем видео", "items": { "type": "string" } },
        "tools_referenced": { "type": "array", "description": "Инструменты, упомянутые в видео", "items": { "type": "string" } },
        "links_referenced": {
          "type": "array",
          "description": "Ссылки, упомянутые в видео",
          "items": {
            "type": "object",
            "properties": {
              "url": { "type": "string", "format": "uri" },
              "description": { "type": "string" }
            }
          }
        },
        "timestamps": {
          "type": "array",
          "description": "Оглавление видео (временные метки разделов)",
          "items": {
            "type": "object",
            "properties": {
              "time": { "type": "string", "pattern": "^([0-9]{1,2}:)?[0-9]{2}:[0-9]{2}$" },
              "title": { "type": "string" }
            }
          }
        },
        "hashtags": { "type": "array", "description": "Хештеги видео (из описания)", "items": { "type": "string" } }
      }
    },
    "description": { "type": "string", "description": "Подробное описание содержания видео" },
    "tags": { "type": "array", "description": "Теги для поиска и категоризации", "items": { "type": "string" } },
    "transcription": {
      "type": "array",
      "description": "Полная транскрипция видео с таймкодами",
      "items": {
        "type": "object",
        "required": ["start", "text"],
        "properties": {
          "start": { "type": "string", "description": "Время начала сегмента", "pattern": "^([0-9]{1,2}:)?[0-9]{2}:[0-9]{2}$" },
          "end": { "type": "string", "description": "Время окончания сегмента", "pattern": "^([0-9]{1,2}:)?[0-9]{2}:[0-9]{2}$" },
          "speaker": { "type": "string", "description": "Имя спикера (если несколько)" },
          "text": { "type": "string", "description": "Текст транскрипции" },
          "annotations": {
            "type": "array",
            "description": "Аннотации (визуальные элементы, текст на экране)",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string", "enum": ["VISUAL", "TEXT", "ACTION", "SOUND"] },
                "content": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "taxonomy_analysis": {
      "type": "object",
      "description": "Таксономический анализ видео",
      "properties": {
        "workflows": {
          "type": "array",
          "description": "Идентифицированные рабочие процессы",
          "items": {
            "type": "object",
            "required": ["workflow_name", "objective"],
            "properties": {
              "workflow_id": { "type": "string", "description": "ID (WF-XXX-NNN или WRF-NNN)" },
              "workflow_name": { "type": "string" },
              "objective": { "type": "string" },
              "steps": { "type": "array", "items": { "type": "string" } },
              "tasks": { "type": "array", "items": { "type": "string" }, "description": "Связанные задачи (TSK-XXX)" },
              "duration": { "type": "string" },
              "complexity": { "type": "string", "enum": ["Low", "Medium", "High", "Critical"] },
              "tools_used": { "type": "array", "items": { "type": "string" } },
              "input": { "type": "string" },
              "output": { "type": "string" },
              "department": { "type": "string" },
              "enrichment_rate": { "type": "string", "description": "Процент обогащения (для lead gen)" },
              "related_entities": {
                "type": "object",
                "properties": {
                  "tasks": { "type": "array", "items": { "type": "string" } },
                  "tools": { "type": "array", "items": { "type": "string" } },
                  "actions": { "type": "array", "items": { "type": "string" } },
                  "professions": { "type": "array", "items": { "type": "string" } }
                }
              },
              "status": { "type": "string", "enum": ["Pending_Review", "Approved", "Deprecated"] }
            }
          }
        },
        "milestones": {
          "type": "array",
          "description": "Вехи проекта (MLS-XXX)",
          "items": {
            "type": "object",
            "properties": {
              "milestone_id": { "type": "string" },
              "name": { "type": "string" },
              "description": { "type": "string" },
              "deliverable": { "type": "string" },
              "tasks": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "tasks": {
          "type": "array",
          "description": "Шаблоны задач (Task Templates)",
          "items": {
            "type": "object",
            "properties": {
              "task_id": { "type": "string" },
              "task_name": { "type": "string" },
              "department": { "type": "string" },
              "action": { "type": "string" },
              "object": { "type": "string" },
              "context": { "type": "string" },
              "complexity": { "type": "string", "enum": ["Low", "Medium", "High"] },
              "time_estimate": { "type": "string" },
              "parent_project": { "type": "string" },
              "steps_used": { "type": "array", "items": { "type": "string" } },
              "skills_required": { "type": "array", "items": { "type": "string" } },
              "tools": { "type": "array", "items": { "type": "string" } },
              "input": { "type": "string" },
              "output": { "type": "string" },
              "success_criteria": { "type": "string" },
              "reusable_in": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "steps": {
          "type": "array",
          "description": "Шаблоны шагов (Step Templates)",
          "items": {
            "type": "object",
            "properties": {
              "step_id": { "type": "string" },
              "step_name": { "type": "string" },
              "action": { "type": "string" },
              "object": { "type": "string" },
              "tool": { "type": "string" },
              "parent_tasks": { "type": "array", "items": { "type": "string" } },
              "complexity": { "type": "string" },
              "time_estimate": { "type": "string" },
              "input": { "type": "string" },
              "output": { "type": "string" },
              "prerequisites": { "type": "array", "items": { "type": "string" } },
              "instructions": { "type": "array", "items": { "type": "string" } },
              "reusable_in": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "projects": {
          "type": "array",
          "description": "Шаблоны проектов (Project Templates)",
          "items": {
            "type": "object",
            "properties": {
              "project_id": { "type": "string" },
              "project_name": { "type": "string" },
              "department": { "type": "string" },
              "description": { "type": "string" },
              "duration": { "type": "string" },
              "complexity": { "type": "string" },
              "phases": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "phase_name": { "type": "string" },
                    "description": { "type": "string" },
                    "duration": { "type": "string" },
                    "output": { "type": "string" },
                    "milestones": { "type": "array", "items": { "type": "string" } }
                  }
                }
              }
            }
          }
        },
        "action_verbs": {
          "type": "object",
          "description": "Категоризированные глаголы действий",
          "properties": {
            "creation_verbs": { "type": "array", "items": { "type": "string" } },
            "modification_verbs": { "type": "array", "items": { "type": "string" } },
            "analysis_verbs": { "type": "array", "items": { "type": "string" } },
            "organization_verbs": { "type": "array", "items": { "type": "string" } },
            "communication_verbs": { "type": "array", "items": { "type": "string" } },
            "browser_agentic_operations": { "type": "array", "items": { "type": "string" } },
            "data_operations": { "type": "array", "items": { "type": "string" } }
          }
        },
        "task_chains": { "type": "array", "description": "Цепочки задач Step1 → Step2 → Output", "items": { "type": "string" } },
        "responsibilities_vocabulary": {
          "type": "object",
          "properties": {
            "roles": { "type": "array", "items": { "type": "string" } },
            "activities": { "type": "array", "items": { "type": "string" } },
            "skills": { "type": "array", "items": { "type": "string" } }
          }
        },
        "skills": {
          "type": "array",
          "description": "Извлеченные навыки (Skills Extraction)",
          "items": {
            "type": "object",
            "properties": {
              "skill_id": { "type": "string" },
              "skill_name": { "type": "string" },
              "skill_phrase": { "type": "string" },
              "difficulty": { "type": "string", "enum": ["Beginner", "Intermediate", "Advanced", "Expert"] },
              "professions": { "type": "array", "items": { "type": "string" } },
              "parent_tasks": { "type": "array", "items": { "type": "string" } },
              "workflows": { "type": "array", "items": { "type": "string" } },
              "tools_required": { "type": "array", "items": { "type": "string" } },
              "time_to_learn": { "type": "string" },
              "description": { "type": "string" }
            }
          }
        },
        "professions": {
          "type": "array",
          "description": "Профессиональные роли",
          "items": {
            "type": "object",
            "properties": {
              "profession_id": { "type": "string" },
              "role_name": { "type": "string" },
              "department": { "type": "string" },
              "description": { "type": "string" },
              "related_skills": { "type": "array", "items": { "type": "string" } },
              "related_tools": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "tools_matrix": {
          "type": "array",
          "description": "Матрица инструментов",
          "items": {
            "type": "object",
            "required": ["tool", "category"],
            "properties": {
              "tool_id": { "type": "string" },
              "tool": { "type": "string" },
              "category": { "type": "string" },
              "purpose": { "type": "string" },
              "used_for": { "type": "string" },
              "vendor": { "type": "string" },
              "department": { "type": "string" },
              "source_video": { "type": "string" },
              "integrations": { "type": "array", "items": { "type": "string" } },
              "related_tools": { "type": "array", "items": { "type": "string" } },
              "mentioned_with": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "objects_deliverables": {
          "type": "array",
          "description": "Объекты и результаты работы",
          "items": {
            "type": "object",
            "properties": {
              "object_id": { "type": "string" },
              "name": { "type": "string" },
              "type": { "type": "string", "enum": ["Design_Deliverable", "Document", "Media_Object", "Data_Asset", "Code_Artifact"] },
              "description": { "type": "string" },
              "related_tools": { "type": "array", "items": { "type": "string" } },
              "related_workflows": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "integration_patterns": {
          "type": "array",
          "description": "Паттерны интеграции",
          "items": {
            "type": "object",
            "properties": {
              "pattern_id": { "type": "string" },
              "integration": { "type": "string" },
              "purpose": { "type": "string" },
              "entity_chain": { "type": "string" },
              "flow": { "type": "string" },
              "department": { "type": "string" },
              "professions": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "business_concepts": { "type": "array", "items": { "type": "string" } },
        "optimization_techniques": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "technique_id": { "type": "string" },
              "optimization": { "type": "string" },
              "technique": { "type": "string" },
              "reason": { "type": "string" },
              "evidence": { "type": "string" }
            }
          }
        },
        "entities_summary": {
          "type": "object",
          "description": "Сводка всех извлеченных сущностей",
          "properties": {
            "total_entities": { "type": "integer" },
            "tools_count": { "type": "integer" },
            "workflows_count": { "type": "integer" },
            "actions_count": { "type": "integer" },
            "objects_count": { "type": "integer" },
            "skills_count": { "type": "integer" },
            "professions_count": { "type": "integer" },
            "primary_department": { "type": "string" },
            "secondary_departments": { "type": "array", "items": { "type": "string" } }
          }
        },
        "hierarchy_trees": {
          "type": "array",
          "description": "Иерархические деревья связей сущностей",
          "items": {
            "type": "object",
            "properties": {
              "tree_name": { "type": "string" },
              "root_entity": { "type": "string" },
              "children": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "department_distribution": {
          "type": "object",
          "description": "Распределение сущностей по департаментам",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "tools": { "type": "integer" },
              "workflows": { "type": "integer" },
              "actions": { "type": "integer" },
              "objects": { "type": "integer" },
              "skills": { "type": "integer" },
              "professions": { "type": "integer" },
              "total": { "type": "integer" }
            }
          }
        },
        "reusability_analysis": {
          "type": "array",
          "description": "Анализ повторного использования",
          "items": {
            "type": "object",
            "properties": {
              "entity_type": { "type": "string", "enum": ["task", "step", "workflow"] },
              "entity_id": { "type": "string" },
              "reusable_in": { "type": "array", "items": { "type": "string" } },
              "variations": { "type": "array", "items": { "type": "string" } },
              "similar_entities": { "type": "array", "items": { "type": "string" } }
            }
          }
        },
        "success_metrics": {
          "type": "array",
          "description": "Метрики успеха и производительности",
          "items": {
            "type": "object",
            "properties": {
              "metric_name": { "type": "string" },
              "workflow_or_task": { "type": "string" },
              "value": { "type": "string" },
              "context": { "type": "string" },
              "benchmark": { "type": "string" }
            }
          }
        }
      }
    },
    "processing_status": {
      "type": "object",
      "description": "Статус обработки транскрипции",
      "properties": {
        "phase_1_transcription": { "type": "string", "enum": ["pending", "in_progress", "complete"], "default": "pending" },
        "phase_2_naming": { "type": "string", "enum": ["pending", "in_progress", "complete", "skipped"], "default": "pending" },
        "phase_3_analysis": { "type": "string", "enum": ["pending", "in_progress", "complete"], "default": "pending" },
        "phase_4_objects": { "type": "string", "enum": ["pending", "in_progress", "complete"], "default": "pending" },
        "phase_5_gap_analysis": { "type": "string", "enum": ["pending", "in_progress", "complete"], "default": "pending" },
        "phase_6_taxonomy_updates": { "type": "string", "enum": ["pending", "in_progress", "complete"], "default": "pending" },
        "phase_7_reporting": { "type": "string", "enum": ["pending", "in_progress", "complete"], "default": "pending" },
        "last_updated": { "type": "string", "format": "date-time" },
        "updated_by": { "type": "string" }
      }
    },
    "analysis_files": {
      "type": "array",
      "description": "Связанные файлы анализа",
      "items": {
        "type": "object",
        "properties": {
          "file_name": { "type": "string" },
          "file_path": { "type": "string" },
          "type": { "type": "string", "enum": ["extraction", "gap_analysis", "mapping_report", "processing_summary", "execution_flow", "taxonomy_extraction", "phase3_analysis", "phase4_objects", "taxonomy_integration"] }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Информация о происхождении и обработке видео",
      "properties": {
        "taxonomy_status": { "type": "string", "enum": ["Pending_Review", "Approved", "Ready_for_Import"] },
        "ready_for_import": { "type": "boolean" },
        "validation_required": { "type": "boolean" },
        "notes": { "type": "string" },
        "main_topics": { "type": "array", "items": { "type": "string" } },
        "key_workflows": { "type": "array", "items": { "type": "string" } },
        "notable_tools": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}

